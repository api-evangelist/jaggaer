{
  "opencollection": "1.0.0",
  "info": {
    "name": "JAGGAER ASO Customer Host Entity Service Async Awards API",
    "version": "v26.0.0.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Awards",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Awards by Preferred Scenario (Asynchronous)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ches.aso-api.jaggaer.com/event/:event-id/scenario/preferred/apiAwards/async",
            "params": [
              {
                "name": "event-id",
                "value": "",
                "type": "path",
                "description": "Identifier for the sourcing event."
              }
            ]
          },
          "docs": "Initiates an asynchronous retrieval of awards for the preferred scenario of the given event. Returns a process ID for polling via /asyncStatus/{encoded-async-pid}.\n"
        },
        {
          "info": {
            "name": "Awards by Scenario (Asynchronous)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ches.aso-api.jaggaer.com/event/:event-id/scenario/:scenario-id/apiAwards/async",
            "params": [
              {
                "name": "event-id",
                "value": "",
                "type": "path",
                "description": "Identifier for the sourcing event."
              },
              {
                "name": "scenario-id",
                "value": "",
                "type": "path",
                "description": "Identifier for the award scenario."
              }
            ]
          },
          "docs": "Initiates an asynchronous retrieval of awards for the specified scenario of the given event. Returns a process ID for polling via /asyncStatus/{encoded-async-pid}.\n"
        }
      ]
    }
  ],
  "bundled": true
}