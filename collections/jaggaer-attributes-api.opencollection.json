{
  "opencollection": "1.0.0",
  "info": {
    "name": "JAGGAER ASO Customer Host Entity Service Async Attributes API",
    "version": "v26.0.0.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Attributes",
        "type": "folder"
      },
      "items": [
