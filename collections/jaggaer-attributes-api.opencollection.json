        {
          "info": {
            "name": "Attributes by Type",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ches.aso-api.jaggaer.com/event/:event-id/attributeType/:attribute-type/apiAttributes",
            "params": [
              {
                "name": "event-id",
                "value": "",
                "type": "path",
                "description": "Identifier for the sourcing event."
              },
              {
                "name": "attribute-type",
                "value": "",
                "type": "path",
                "description": "The attribute type filter."
              }
            ]
          },
          "docs": "Retrieves all attributes of the specified type for the given sourcing event.\n"
        }
