{
  "opencollection": "1.0.0",
  "info": {
    "name": "JAGGAER ASO Customer Host Entity Service Async Scenarios API",
    "version": "v26.0.0.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Scenarios",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Scenarios",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ches.aso-api.jaggaer.com/event/:event-id/apiScenarios",
            "params": [
              {
                "name": "event-id",
                "value": "",
                "type": "path",
                "description": "Identifier for the sourcing event."
              }
            ]
          },
          "docs": "Retrieves all award scenarios for the given sourcing event."
        }
      ]
    }
  ],
  "bundled": true
}